# Port HTTP du site
PORT=3000
# URL publique du site (utilisée pour les liens de preuve envoyés sur Discord)
PUBLIC_URL=http://localhost:3000

# Bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
# Salon où arrivent les chronos à vérifier
DISCORD_CHANNEL_ID=
# Optionnel : rôle autorisé à valider/refuser (sinon : permission « Gérer les messages »)
DISCORD_MOD_ROLE_ID=

# Optionnel
# DB_PATH=./data/leaderboard.db
# MAX_UPLOAD_MB=50
# RATE_LIMIT=10
