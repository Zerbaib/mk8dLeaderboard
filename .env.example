# HTTP port
PORT=3000
# Public URL of the site (used for proof links sent to Discord and on the legal pages)
PUBLIC_URL=https://mk8dxtimes.com
SITE_NAME=MK8DX Times

# Discord bot (https://discord.com/developers/applications)
DISCORD_TOKEN=
# Channel where submissions are posted for review
DISCORD_CHANNEL_ID=
# Login with Discord (Developer Portal > your application > OAuth2): Client ID and Client Secret.
# Add the redirect URL <PUBLIC_URL>/auth/discord/callback in the same page.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord user IDs allowed to open /admin (statistics), comma-separated.
# Discord: Settings > Advanced > Developer Mode, then right-click your name > Copy User ID
ADMIN_DISCORD_IDS=
# Optional: role allowed to approve/reject (otherwise: "Manage Messages" permission)
DISCORD_MOD_ROLE_ID=
# Optional: roles given automatically by the bot (Server settings > Roles > right-click > Copy Role ID).
# Needs "Server Members Intent" (Developer Portal > Bot) and the "Manage Roles" permission,
# and the bot's role must be ABOVE these roles in the server's role list.
DISCORD_VERIFIED_ROLE_ID=
DISCORD_WR_ROLE_ID=
DISCORD_FORMER_WR_ROLE_ID=
DISCORD_TOP10_ROLE_ID=
# How often the leaderboard roles are recomputed (hours)
ROLE_SYNC_HOURS=48
# Optional: bot status text (default: 🚀 go on mk8dxtimes.com)
DISCORD_BOT_STATUS=
# Optional: webhook where new records are announced (Channel settings > Integrations > Webhooks)
DISCORD_RECORDS_WEBHOOK_URL=
# Optional: public invite to your Discord server, shown on the Terms page
DISCORD_INVITE_URL=

# Legal information (shown on Terms of Use / Privacy Policy / Legal Notice)
# Site address used in the Terms of Use, canonical URLs, sitemap and link previews
LEGAL_SITE_URL=https://mk8dxtimes.com
LEGAL_OWNER_NAME=
LEGAL_OWNER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
# Rejected submissions are deleted after this many days
REJECTED_RETENTION_DAYS=30

# Optional
# DB_PATH=./data/leaderboard.db
# MAX_UPLOAD_MB=50
# RATE_LIMIT=10
